# GeoPresensi migration stack: Go/Fiber + GORM + MySQL, React/Vite frontend
# Local-only option: set DB_DRIVER=sqlite and use DB_PATH=./data/geopresensi.db.
# Staging/production must keep DB_DRIVER=mysql.
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
STATIC_DIR=./dist
FRONTEND_ORIGINS=http://localhost:5173
# Staging/production wajib memakai APP_URL dan FRONTEND_ORIGINS HTTPS.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geopresensi
DB_DRIVER=mysql
DB_PATH=./data/geopresensi.db
DB_USER=geopresensi
DB_PASS=change-me
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_CONN_MAX_IDLE_TIME_MINUTES=5
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=10s
DB_WRITE_TIMEOUT=10s

JWT_ISSUER=geopresensi
JWT_AUDIENCE=geopresensi-web
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false

# OAuth/anti-bot/integrations: private secrets stay server-side.
GOOGLE_CLIENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
N8N_API_KEY=
HERMES_API_KEY=
# Read-only key for the journal application's attendance-status and teacher-identity endpoints.
JOURNAL_API_KEY=
GOWA_WEBHOOK_URL=
GOWA_USERNAME=
GOWA_PASSWORD=
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Frontend build fallback; runtime endpoint remains the source of truth.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
